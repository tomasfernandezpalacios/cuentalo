{
  "expo": {
    "name": "Cuéntalo",
    "slug": "cuentalo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cuentalo.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.cuentalo.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0A09",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.WRITE_CONTACTS"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F3EEE4",
          "dark": {
            "backgroundColor": "#0B0A09"
          }
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Cuéntalo usa tus contactos para mostrarte cuáles de ellos usan la app."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cuéntalo usa tus fotos para poner una imagen a tu perfil, a tus grupos y a tus contadores.",
          "cameraPermission": "Cuéntalo usa la cámara para hacer la foto de tu perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#E9C46A"
        }
      ]
    ],
    "scheme": "cuentalo"
  }
}
